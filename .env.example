SECRET_KEY=django-insecure-dev-key-marketmind-2026-local
DB_NAME=marketmind_db
DB_USER=marketmind_user
DB_PASSWORD=localpass123
INTERNAL_EVENT_TOKEN=dev-internal-event-token
# Secreto compartido con n8n (mismo valor que en backend/.env)
N8N_WEBHOOK_TOKEN=dev-n8n-webhook-token
# Base de los callbacks de n8n hacia Django (sin barra final)
DJANGO_CALLBACK_BASE_URL=http://host.docker.internal:8000
GEMINI_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Puertos del host para docker compose (sin secretos). Los valores son los de siempre;
# cámbialos solo si el puerto ya está ocupado en tu equipo.
# Si cambias uno, actualiza también quien lo usa desde fuera de Docker:
#   POSTGRES_HOST_PORT -> DB_PORT en backend/.env (Django corre fuera de Docker)
#   N8N_HOST_PORT      -> N8N_WEBHOOK_URL en backend/.env
#   SPRINGBOOT_HOST_PORT -> VITE_USER_API_URL en frontend/.env
#   REDIS_HOST_PORT    -> REDIS_URL en backend/.env
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
N8N_HOST_PORT=5678
SPRINGBOOT_HOST_PORT=8080

# Django no corre en Docker. Si no usa el puerto 8000, cambia el puerto aquí (Spring)
# y en DJANGO_CALLBACK_BASE_URL (n8n), más arriba.
DJANGO_INTERNAL_URL=http://host.docker.internal:8000
