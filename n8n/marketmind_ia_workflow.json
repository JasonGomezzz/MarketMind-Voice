          }
        ],
        [
          {
            "node": "Prompt Engineering",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generar Texto Mock": {
      "main": [
        [
          {
            "node": "Callback Éxito (Mock)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prompt Engineering": {
      "main": [
        [
          {
            "node": "Gemini 2.5 Flash",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Gemini 2.5 Flash": {
      "main": [
        [
          {
            "node": "¿Hubo Error?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "¿Hubo Error?": {
      "main": [
        [
          {
            "node": "Callback Fallo",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Extraer Texto Gemini",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extraer Texto Gemini": {
      "main": [
        [
          {
            "node": "Callback Éxito (Real)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "callerPolicy": "workflowsFromSameOwner",
    "errorWorkflow": ""
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": ["marketmind", "ia", "async"]
}
